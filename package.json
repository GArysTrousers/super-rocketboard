{
	"name": "super-rocketboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build-sea": "vite build --config vite.sea.config.ts",
		"compile": "vite build && node --build-sea sea-config.json",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:types": "deno run -WR ./src/lib/sqlite-type-generator.ts"
	},
	"dependencies": {
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@jesterkit/exe-sveltekit": "^0.1.7",
		"cookie": "^1.0.0",
		"cross-image": "^0.4.3",
		"jsonwebtoken": "^9.0.3",
		"prompt-sync": "^4.2.0",
		"svelte-dnd-action": "^0.9.79",
		"svelte-fa": "^4.0.4",
		"uuid": "^14.0.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24",
		"@types/prompt-sync": "^4.2.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	}
}
